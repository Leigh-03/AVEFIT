---
import { exercises } from '@bryllim/workout-guide';
import ExerciseCard from '../../components/ExerciseCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const collator = new Intl.Collator('en');
const equipment = [...new Set(exercises.map((exercise) => exercise.equipment))].sort(collator.compare);
const muscles = [...new Set(exercises.map((exercise) => exercise.primaryMuscle))].sort(collator.compare);
const types = [...new Set(exercises.map((exercise) => exercise.exerciseType))].sort(collator.compare);
const typeLabel = (type: string) => type.split('_').map((word) => word[0].toUpperCase() + word.slice(1)).join(' ');
---

<BaseLayout title="Exercise gallery — Workout Guide" description="Search and filter 302 open exercise illustrations by name, equipment, muscle, and exercise type.">
  <header class="page-intro page-shell"><div><p class="eyebrow">302 exercises · 906 frames</p><h1>Find the movement you need.</h1></div><p>Search a complete, consistent library of strength, mobility, cardio, and stretch illustrations.</p></header>
  <section class="page-shell gallery-section" aria-labelledby="gallery-title">
    <h2 class="sr-only" id="gallery-title">Exercise gallery</h2>
    <form class="filter-panel" data-exercise-filters role="search">
      <label><span class="field-label">Search</span><span class="field-surface" data-squircle data-radius="19"><input type="search" name="q" placeholder="Name, equipment, or muscle" autocomplete="off" /></span></label>
      <label><span class="field-label">Equipment</span><span class="field-surface" data-squircle data-radius="19"><select name="equipment"><option value="">All equipment</option>{equipment.map((value) => <option value={value}>{value}</option>)}</select></span></label>
      <label><span class="field-label">Muscle</span><span class="field-surface" data-squircle data-radius="19"><select name="muscle"><option value="">All muscles</option>{muscles.map((value) => <option value={value}>{value}</option>)}</select></span></label>
      <label><span class="field-label">Type</span><span class="field-surface" data-squircle data-radius="19"><select name="type"><option value="">All types</option>{types.map((value) => <option value={value}>{typeLabel(value)}</option>)}</select></span></label>
    </form>
    <p class="result-meta" id="result-count" role="status" aria-live="polite">Showing all {exercises.length} exercises</p>
    <div class="exercise-grid" data-exercise-grid>{exercises.map((exercise) => <ExerciseCard exercise={exercise} />)}</div>
    <div class="empty-state" data-empty-state hidden><h2>No exercises found.</h2><p>Try a broader search or clear a filter.</p></div>
  </section>
  <script>
    const form = document.querySelector<HTMLFormElement>('[data-exercise-filters]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-exercise-card]'));
    const resultCount = document.querySelector<HTMLElement>('#result-count');
    const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');
    const normalize = (value: string) => value.toLocaleLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim();
    if (form) {
      const params = new URLSearchParams(window.location.search);
      for (const field of ['q', 'equipment', 'muscle', 'type']) {
        const control = form.elements.namedItem(field) as HTMLInputElement | HTMLSelectElement | null;
        if (control) control.value = params.get(field) ?? '';
      }
      const update = () => {
        const data = new FormData(form);
        const tokens = normalize(String(data.get('q') ?? '')).split(/\s+/).filter(Boolean);
        const equipmentValue = String(data.get('equipment') ?? '');
        const muscleValue = String(data.get('muscle') ?? '');
        const typeValue = String(data.get('type') ?? '');
        let visible = 0;
        for (const card of cards) {
          const searchable = normalize(card.dataset.search ?? '');
          const matches = tokens.every((token) => searchable.includes(token)) && (!equipmentValue || card.dataset.equipment === equipmentValue) && (!muscleValue || card.dataset.muscle === muscleValue) && (!typeValue || card.dataset.type === typeValue);
          card.hidden = !matches;
          if (matches) visible += 1;
        }
        if (resultCount) resultCount.textContent = visible === cards.length ? `Showing all ${visible} exercises` : `${visible} exercise${visible === 1 ? '' : 's'} found`;
        if (emptyState) emptyState.hidden = visible !== 0;
        const nextParams = new URLSearchParams();
        for (const field of ['q', 'equipment', 'muscle', 'type']) {
          const value = String(data.get(field) ?? '').trim();
          if (value) nextParams.set(field, value);
        }
        const nextUrl = nextParams.size ? `${window.location.pathname}?${nextParams}` : window.location.pathname;
        window.history.replaceState({}, '', nextUrl);
      };
      form.addEventListener('input', update);
      form.addEventListener('change', update);
      update();
    }
  </script>
</BaseLayout>
